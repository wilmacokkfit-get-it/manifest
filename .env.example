# Copy these into Replit -> Tools -> Secrets (one key per row). Locally, copy to .env.

# ---- Text + renders with ONE OpenAI key (simplest) ----
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_REASONING_EFFORT=medium   # gpt-5 models only; low/medium/high. Compare before lowering quality.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium          # low = 1 cent per render, medium = 4 cents, high = 17 cents
RENDER_COUNT=2                # renders per venture (0-3). 0 = text only.

# ---- Or write the text with Claude instead (better prose, similar price) ----
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5

# ---- Database. Blank = built-in SQLite file in data/ (fine to start). ----
# STORE=auto                  # auto, sqlite, or supabase; explicit mode never silently switches
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # legacy alternative to SUPABASE_SECRET_KEY
# SUPABASE_RENDERS_BUCKET=renders

# ---- Public address, used for share links and link-preview cards ----
PUBLIC_URL=https://your-app.replit.app

# ---- Spend limits ----
GEN_PER_HOUR=3                # ventures per visitor per hour
GEN_PER_DAY=8                 # ventures per visitor per day
GLOBAL_PER_DAY=150            # ventures site-wide per day (150 x ~9 cents = ~$14 worst day)
MARK_THRESHOLD_SIGNALS=25
MARK_THRESHOLD_BUILD_FUND=5
