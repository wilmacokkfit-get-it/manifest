# ---- Text model (pick ONE provider) ----
# Anthropic (recommended): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5

# OpenAI alternative: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini

# ---- Product renders (OpenAI Images). Set IMAGE_PROVIDER=none to skip renders. ----
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1

# ---- Database + image storage. Leave blank to use the built-in SQLite file (fine for testing). ----
SUPABASE_URL=https://lvtehfciwiiakpdtwlyx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RENDERS_BUCKET=renders

# ---- Public address of your deployment (used for share links and OG cards) ----
PUBLIC_URL=https://your-app.replit.app

# ---- Limits (per visitor / whole site) ----
GEN_PER_HOUR=3
GEN_PER_DAY=8
GLOBAL_PER_DAY=150
MARK_THRESHOLD_SIGNALS=25
MARK_THRESHOLD_BUILD_FUND=5
